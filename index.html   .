<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>☎ Алло! Дисковий телефон</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Special+Elite&family=Caveat:wght@400;700&display=swap');

* { margin:0; padding:0; box-sizing:border-box; touch-action:none; }

body {
  background: #160d05;
  background-image:
    radial-gradient(ellipse 60% 80% at 15% 50%, #2a1608 0%, transparent 70%),
    radial-gradient(ellipse 60% 80% at 85% 50%, #1c1006 0%, transparent 70%);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-family: 'Special Elite', cursive;
  padding: 16px;
  overflow-x: hidden;
}

.title {
  font-family: 'Caveat', cursive;
  font-size: 2.4rem;
  font-weight: 700;
  color: #ecdda0;
  letter-spacing: 3px;
  text-align: center;
  text-shadow: 0 2px 12px rgba(0,0,0,.9);
  margin-bottom: 4px;
}
.subtitle {
  text-align: center;
  color: #7a5c38;
  font-size: .72rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  margin-bottom: 18px;
}

.table {
  width: 100%;
  max-width: 500px;
  background: linear-gradient(160deg, #8a5c38 0%, #663618 50%, #512a10 100%);
  border-radius: 14px 14px 0 0;
  padding: 26px 24px 0;
  box-shadow: 0 -4px 24px rgba(0,0,0,.7),
              inset 0 2px 4px rgba(255,255,255,.08),
              inset 0 -2px 8px rgba(0,0,0,.5);
}
.table-base {
  width: 100%;
  max-width: 500px;
  height: 18px;
  background: linear-gradient(180deg, #4a2a0e 0%, #3a1e08 100%);
  border-radius: 0 0 10px 10px;
  box-shadow: 0 10px 32px rgba(0,0,0,.8);
  margin-bottom: 18px;
}

.phone {
  background: linear-gradient(140deg, #f6edcf 0%, #eadda8 35%, #ddd098 70%, #cec082 100%);
  border-radius: 14px 14px 10px 10px;
  padding: 18px 20px 16px;
  position: relative;
  box-shadow: 0 6px 28px rgba(0,0,0,.55),
              inset 0 1px 3px rgba(255,255,255,.55),
              inset 0 -2px 5px rgba(0,0,0,.25);
}
.phone::after {
  content:'';
  position:absolute; inset:0;
  border-radius: 14px 14px 10px 10px;
  background: linear-gradient(135deg, rgba(255,255,255,.14) 0%, transparent 55%);
  pointer-events:none;
}

.handset {
  position: absolute;
  top: -18px; left: 18px; right: 18px;
  height: 50px;
  background: linear-gradient(180deg, #f0e5c5 0%, #ddd098 55%, #c8a860 100%);
  border-radius: 32px;
  box-shadow: 0 5px 14px rgba(0,0,0,.45),
              inset 0 1px 3px rgba(255,255,255,.5),
              inset 0 -1px 4px rgba(0,0,0,.35);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 9px 22px;
  z-index: 10;
}
.handset.ringing { animation: ring .12s ease-in-out infinite; }
@keyframes ring {
  0%,100%{ transform:translateX(0) rotate(0deg); }
  25%    { transform:translateX(-3px) rotate(-.8deg); }
  75%    { transform:translateX(3px) rotate(.8deg); }
}
.speaker {
  width:38px; height:26px; background:#c4a465; border-radius:5px;
  display:grid; grid-template:repeat(3,1fr)/repeat(3,1fr); gap:3px; padding:4px;
}
.sd { background:#8a6020; border-radius:50%; }

.phone-inner {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-top: 46px;
}

.side {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 0;
}
.display {
  background: linear-gradient(135deg, #180e04, #0e0a02);
  border: 2px solid #5a3818;
  border-radius: 8px;
  padding: 10px 14px;
  box-shadow: inset 0 2px 10px rgba(0,0,0,.9), 0 1px 2px rgba(255,255,255,.07);
}
.display-lbl {
  color: #5a3c18; font-size:.6rem; letter-spacing:2.5px; text-transform:uppercase;
  display:flex; align-items:center; gap:6px; margin-bottom:4px;
}
.sled {
  width:7px; height:7px; border-radius:50%; background:#1e1008; transition:all .3s;
}
.sled.on {
  background:#f0c030;
  box-shadow: 0 0 6px #f0c030, 0 0 14px rgba(240,192,48,.45);
  animation: blink 1s infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.35} }
.display-num {
  color:#f0c030; font-size:1.7rem; letter-spacing:9px; min-height:2rem;
  text-shadow: 0 0 10px rgba(240,192,48,.5);
}
.display-num.pulse { animation: gpulse .45s ease; }
@keyframes gpulse {
  0%  { text-shadow: 0 0 10px rgba(240,192,48,.5); }
  50% { text-shadow: 0 0 22px #f0c030, 0 0 44px rgba(240,192,48,.55); }
  100%{ text-shadow: 0 0 10px rgba(240,192,48,.5); }
}
.btns { display:flex; gap:8px; }
.btn {
  flex:1; padding:9px 4px; border:none; border-radius:7px;
  font-family:'Special Elite',cursive; font-size:.72rem;
  cursor:pointer; letter-spacing:1px; text-transform:uppercase; transition:all .15s;
}
.btn-call {
  background:linear-gradient(135deg,#2a5a2c,#1c3c1e); color:#88d088;
  box-shadow:0 3px 8px rgba(0,0,0,.45),inset 0 1px rgba(255,255,255,.1);
  border-bottom:3px solid #0e1e10;
}
.btn-call:hover  { filter:brightness(1.2); transform:translateY(-1px); }
.btn-call:active { transform:translateY(1px); border-bottom-width:1px; }
.btn-clr {
  background:linear-gradient(135deg,#5a1818,#3c1010); color:#e06060;
  box-shadow:0 3px 8px rgba(0,0,0,.45),inset 0 1px rgba(255,255,255,.1);
  border-bottom:3px solid #1e0808;
}
.btn-clr:hover  { filter:brightness(1.2); transform:translateY(-1px); }
.btn-clr:active { transform:translateY(1px); border-bottom-width:1px; }
.hint { color:#6a4820; font-family:'Caveat',cursive; font-size:.9rem; text-align:center; }

/* ── DIAL ── */
.dial-wrap {
  position:relative; width:200px; height:200px; flex-shrink:0;
  cursor:grab; user-select:none;
}
.dial-wrap:active { cursor:grabbing; }
.dial-plate {
  position:absolute; inset:0; border-radius:50%;
  background:linear-gradient(135deg,#d0b870 0%,#c0a050 60%,#a88030 100%);
  box-shadow:0 4px 18px rgba(0,0,0,.5),
             inset 0 2px 5px rgba(255,255,255,.28),
             inset 0 -2px 7px rgba(0,0,0,.35);
}
#dialSvg {
  position:absolute; inset:0; width:200px; height:200px;
  will-change:transform; transform-origin:center;
}
.finger-stop {
  position:absolute; top:50%; right:-9px; transform:translateY(-50%);
  width:17px; height:17px; border-radius:50%;
  background:linear-gradient(135deg,#8a5820,#5a3010);
  box-shadow:0 2px 5px rgba(0,0,0,.5); z-index:20; pointer-events:none;
}
.wire { height:28px; display:flex; padding-left:24px; }
.wire svg { width:80px; height:28px; }

/* ── RESPONSE ── */
.response-area { width:100%; max-width:500px; min-height:70px; margin-top:4px; }
.bubble {
  background:rgba(245,236,208,.96); border-radius:12px; padding:14px 18px;
  color:#2c1a0e; font-family:'Caveat',cursive; font-size:1.12rem; line-height:1.55;
  box-shadow:0 4px 20px rgba(0,0,0,.45),inset 0 1px 2px rgba(255,255,255,.8);
  display:none; animation:bIn .38s ease;
}
.bubble.show { display:block; }
@keyframes bIn { from{opacity:0;transform:translateY(8px) scale(.97)} to{opacity:1;transform:translateY(0) scale(1)} }
.bubble-hdr { color:#6b4c2a; font-size:.68rem; letter-spacing:2px; text-transform:uppercase; font-family:'Special Elite',cursive; margin-bottom:5px; }

/* ── PHONE LIST ── */
.list-btn {
  width:100%; max-width:500px; background:none; border:1px solid #5a3818;
  color:#8a6030; font-family:'Special Elite',cursive; font-size:.75rem;
  letter-spacing:2px; text-transform:uppercase; padding:8px 16px; border-radius:7px;
  cursor:pointer; margin-top:10px; transition:all .2s;
}
.list-btn:hover { background:rgba(90,56,24,.3); color:#d0a060; }
.phone-list {
  display:none; background:rgba(18,10,3,.92); border:1px solid #3e2810;
  border-radius:9px; margin-top:7px; width:100%; max-width:500px; overflow:hidden;
}
.phone-list.open { display:block; animation:bIn .28s ease; }
.list-hdr { color:#7a4e20; font-size:.65rem; letter-spacing:3px; text-transform:uppercase; padding:9px 14px 6px; border-bottom:1px solid #2e1a08; }
.entry {
  display:flex; align-items:center; gap:12px; padding:8px 14px;
  border-bottom:1px solid rgba(46,26,8,.5); transition:background .14s;
}
.entry:last-child { border-bottom:none; }
.entry.known { cursor:pointer; }
.entry.known:hover { background:rgba(90,60,20,.35); }
.entry .num { color:#f0c030; font-size:.95rem; min-width:28px; }
.entry .dsc { color:#c8a060; font-family:'Caveat',cursive; font-size:1rem; }
.entry .lck { color:#3a2010; margin-left:auto; font-size:.9rem; }
.disc-bar { text-align:center; color:#5a3c18; font-size:.72rem; letter-spacing:2px; margin-top:8px; width:100%; max-width:500px; }
.disc-bar span { color:#f0c030; text-shadow:0 0 8px rgba(240,192,48,.5); }
</style>
</head>
<body>

<p class="title">☎ Алло!</p>
<p class="subtitle">Дисковий телефон · 1970-ті</p>

<div class="table">
  <div class="phone">

    <div class="handset" id="handset">
      <div class="speaker"><div class="sd"></div><div class="sd"></div><div class="sd"></div><div class="sd"></div><div class="sd"></div><div class="sd"></div><div class="sd"></div><div class="sd"></div><div class="sd"></div></div>
      <div class="speaker"><div class="sd"></div><div class="sd"></div><div class="sd"></div><div class="sd"></div><div class="sd"></div><div class="sd"></div><div class="sd"></div><div class="sd"></div><div class="sd"></div></div>
    </div>

