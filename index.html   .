        <path d="M10,4 Q20,26 30,14 Q40,2 50,18 Q60,30 70,10" stroke="#1a0c04" stroke-width="5" stroke-linecap="round"/>
        <path d="M10,4 Q20,26 30,14 Q40,2 50,18 Q60,30 70,10" stroke="#2e1a08" stroke-width="3" stroke-linecap="round"/>
