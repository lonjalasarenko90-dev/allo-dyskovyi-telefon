            <g data-d="6"  transform="translate(100,100) rotate(126)  translate(0,-70) rotate(-126)"><circle r="14" fill="url(#hg)" stroke="#1a0c04" stroke-width="1.2"/><text text-anchor="middle" dominant-baseline="central" fill="#f0e6c8" font-size="13" font-family="'Special Elite',cursive">6</text></g>
            <g data-d="7"  transform="translate(100,100) rotate(162)  translate(0,-70) rotate(-162)"><circle r="14" fill="url(#hg)" stroke="#1a0c04" stroke-width="1.2"/><text text-anchor="middle" dominant-baseline="central" fill="#f0e6c8" font-size="13" font-family="'Special Elite',cursive">7</text></g>
            <g data-d="8"  transform="translate(100,100) rotate(198)  translate(0,-70) rotate(-198)"><circle r="14" fill="url(#hg)" stroke="#1a0c04" stroke-width="1.2"/><text text-anchor="middle" dominant-baseline="central" fill="#f0e6c8" font-size="13" font-family="'Special Elite',cursive">8</text></g>
            <g data-d="9"  transform="translate(100,100) rotate(234)  translate(0,-70) rotate(-234)"><circle r="14" fill="url(#hg)" stroke="#1a0c04" stroke-width="1.2"/><text text-anchor="middle" dominant-baseline="central" fill="#f0e6c8" font-size="13" font-family="'Special Elite',cursive">9</text></g>
            <g data-d="0"  transform="translate(100,100) rotate(270)  translate(0,-70) rotate(-270)"><circle r="14" fill="url(#hg)" stroke="#1a0c04" stroke-width="1.2"/><text text-anchor="middle" dominant-baseline="central" fill="#f0e6c8" font-size="13" font-family="'Special Elite',cursive">0</text></g>
          </g>
          <circle cx="100" cy="100" r="30" fill="url(#cg)" stroke="#9a7030" stroke-width="1.5"/>
          <circle cx="100" cy="100" r="5"  fill="#7a5020"/>
        </svg>
        <div class="finger-stop"></div>
      </div>

      <div class="side">
        <div class="display">
          <div class="display-lbl">Номер <div class="sled" id="sled"></div></div>
          <div class="display-num" id="dispNum">_ _</div>
        </div>
        <div class="btns">
          <button class="btn btn-call" id="callBtn">▶ Дзвонити</button>
          <button class="btn btn-clr"  id="clrBtn">✕ Стерти</button>
