            <g data-d="1"  transform="translate(100,100) rotate(-54)  translate(0,-70) rotate(54)">  <circle r="14" fill="url(#hg)" stroke="#1a0c04" stroke-width="1.2"/><text text-anchor="middle" dominant-baseline="central" fill="#f0e6c8" font-size="13" font-family="'Special Elite',cursive">1</text></g>
            <g data-d="2"  transform="translate(100,100) rotate(-18)  translate(0,-70) rotate(18)">  <circle r="14" fill="url(#hg)" stroke="#1a0c04" stroke-width="1.2"/><text text-anchor="middle" dominant-baseline="central" fill="#f0e6c8" font-size="13" font-family="'Special Elite',cursive">2</text></g>
            <g data-d="3"  transform="translate(100,100) rotate(18)   translate(0,-70) rotate(-18)"> <circle r="14" fill="url(#hg)" stroke="#1a0c04" stroke-width="1.2"/><text text-anchor="middle" dominant-baseline="central" fill="#f0e6c8" font-size="13" font-family="'Special Elite',cursive">3</text></g>
