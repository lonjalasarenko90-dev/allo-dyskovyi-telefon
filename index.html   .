  </div>
</div>
<div class="table-base"></div>

<div class="response-area">
  <div class="bubble" id="bubble">
    <div class="bubble-hdr">☎ Алло!</div>
    <span id="bubbleText"></span>
  </div>
</div>

<button class="list-btn" id="listBtn">📋 Довідник телефонів</button>
<div class="phone-list" id="phoneList"></div>
<p class="disc-bar">Відкрито: <span id="dCount">0</span> / <span id="dTotal">0</span></p>

<script>
/* ─── Phone book ─────────────────────────────────────────────────── */
const PHONES = {
  "01":{ icon:"👮", desc:"Поліція гумору",    txt:"Поліція гумору, слухаю! Хто тут сьогодні ходить без посмішки? Негайно усміхніться — це наказ!" },
  "02":{ icon:"🚒", desc:"Пожежна",           txt:"Пожежна служба! У вас горить... бажання з'їсти щось смачне! Терміново йдіть на кухню!" },
  "03":{ icon:"🏥", desc:"Швидка допомога",   txt:"Швидка допомога! Терміново прописуємо: теплий чай, улюблений фільм і відпочинок від усіх." },
  "04":{ icon:"📖", desc:"Довідкова",          txt:"Довідкова служба. Сьогоднішня довідка: ви дуже гарна людина. Запишіть і не забувайте." },
  "05":{ icon:"🌤", desc:"Погода",            txt:"Служба погоди! Сьогодні: вранці дощ із цукерок, вдень сонячно з котами, ввечері тепло і затишно." },
  "06":{ icon:"🌲", desc:"Природа",           txt:"🎵 ...шум лісу... пташки співають... вітер у листі... десь вдалині дятел... тихо і добре... 🎵" },
  "07":{ icon:"🛒", desc:"Магазин чудес",     txt:"Магазин чудес, добрий день! Сьогодні акція: безкоштовний гарний настрій при будь-якій покупці!" },
  "08":{ icon:"🕰", desc:"Точний час",        txt:"Пікнуло... пікнуло... зараз точний час — час усміхнутися! Наступний сигнал — через хвилину." },
  "09":{ icon:"💛", desc:"Лінія життя",       txt:"Ви подзвонили на Лінію Життя. Ми хочемо нагадати: ви важливі. Ви потрібні. Ви не дарма тут." },
  "11":{ icon:"🐱", desc:"Котик",             txt:"Мяу! Мяу мяу! Мяу... *муркотить* ...мяу мяу мяу! Мяу. *кладе трубку*" },
  "12":{ icon:"🎵", desc:"Мелодія",           txt:"🎵 Тара-ра-рам... тара-ра-рам... Та-та-та-та-та-таааам! 🎵 (Весела мелодія закінчилась. Гарного дня!)" },
  "13":{ icon:"🎩", desc:"Загадка",           txt:"Добрий день! Загадка: вдень і вночі ходить, а нікуди не йде. Що це? ... Правильно! Це годинник." },
  "14":{ icon:"🔐", desc:"Секретна лінія",   txt:"⚡ Секретна лінія активна. Ваша місія: сьогодні зробити комусь приємне. Удачі. Кінець зв'язку." },
  "22":{ icon:"👵", desc:"Сусідка",          txt:"Алло! Алло! Це ви, Галю? Ні? Ой, вибачте! Ну, раз вже подзвонили — як справи?" },
  "33":{ icon:"🐈", desc:"Кішка директора", txt:"Мурмурмурмур... *тривале муркотіння* ...мняв... *звук горщика* ...МЯУ! *кладе трубку*" },
  "42":{ icon:"✨", desc:"Відповідь на все", txt:"Ви дозвонились до Відповіді на Головне Питання Всесвіту. Відповідь: сорок два. До побачення." },
  "55":{ icon:"🍲", desc:"Рецепт борщу",    txt:"Кулінарна служба! Борщ: картопля, буряк, капуста, морква, цибуля, томат, часник. Варити з любов'ю!" },
  "99":{ icon:"🌙", desc:"???",             txt:"...тихий шум... десь грає стара платівка... голос з минулого каже: все буде добре. Я обіцяю." },
};

/* ─── State ── */
let dialedNumber = "";
let discovered   = new Set();
let busy         = false;

/* ─── DOM ── */
const dispNum  = document.getElementById('dispNum');
const sled     = document.getElementById('sled');
const handset  = document.getElementById('handset');
const bubble   = document.getElementById('bubble');
const bubbleTx = document.getElementById('bubbleText');
const dialSvg  = document.getElementById('dialSvg');
const dialWrap = document.getElementById('dialWrap');
const dCount   = document.getElementById('dCount');
const dTotal   = document.getElementById('dTotal');

/* ─── Audio ── */
function clickTick(f=440) {
  try {
    const c=new (window.AudioContext||window.webkitAudioContext)(),o=c.createOscillator(),g=c.createGain();
    o.connect(g);g.connect(c.destination);
    o.frequency.value=f+Math.random()*80;
    g.gain.setValueAtTime(.15,c.currentTime);
    g.gain.exponentialRampToValueAtTime(.001,c.currentTime+.1);
    o.start();o.stop(c.currentTime+.1);
  } catch(e){}
}
function springSound() {
  try {
    const c=new (window.AudioContext||window.webkitAudioContext)();
    for(let i=0;i<5;i++){const o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);o.frequency.value=580-i*45;const t=c.currentTime+i*.035;g.gain.setValueAtTime(.09,t);g.gain.exponentialRampToValueAtTime(.001,t+.07);o.start(t);o.stop(t+.07);}
  } catch(e){}
}
function playRing() {
  try {
    const c=new (window.AudioContext||window.webkitAudioContext)();
    const beep=(t,f,d)=>{const o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);o.frequency.value=f;g.gain.setValueAtTime(.2,t);g.gain.exponentialRampToValueAtTime(.001,t+d);o.start(t);o.stop(t+d);};
    beep(c.currentTime,.0,480,.28);beep(c.currentTime,.35,480,.28);
    beep(c.currentTime,.9,480,.28);beep(c.currentTime,1.25,480,.28);
    beep(c.currentTime,1.8,480,.28);
  } catch(e){}
}

/* ─── Display ── */
function updateDisp() {
  dispNum.textContent = dialedNumber.padEnd(2,'_').split('').join(' ');
  dispNum.classList.remove('pulse');
  void dispNum.offsetWidth;
  dispNum.classList.add('pulse');
}

function addDigit(d) {
  if (dialedNumber.length>=2||busy) return;
  dialedNumber+=d;
  updateDisp();
}

document.getElementById('clrBtn').onclick=()=>{
  if(busy)return;
  dialedNumber=""; updateDisp();
  bubble.classList.remove('show');
  sled.classList.remove('on');
};

document.getElementById('callBtn').onclick=makeCall;
function makeCall(){
  if(busy)return;
  if(dialedNumber.length<2){showBubble("Наберіть двозначний номер спочатку 😊");return;}
  busy=true; sled.classList.add('on'); handset.classList.add('ringing');
  playRing();
  setTimeout(()=>{
    handset.classList.remove('ringing'); sled.classList.remove('on'); busy=false;
    const rec=PHONES[dialedNumber];
    if(rec){discovered.add(dialedNumber);updateDiscovered();renderList();showBubble(`${rec.icon} ${rec.txt}`);}
    else {
      const u=["Тут нікого немає... або є? 🌫","Зайнято. Спробуйте пізніше.","Хтось підняв трубку і поклав. Дивно.","...гудки... тиша... 📻","Цей номер мовчить."];
      showBubble(u[Math.floor(Math.random()*u.length)]);
    }
  },2400);
}

function showBubble(txt){
  bubble.classList.remove('show'); void bubble.offsetWidth;
  bubbleTx.textContent=txt; bubble.classList.add('show');
}

function updateDiscovered(){dCount.textContent=discovered.size;dTotal.textContent=Object.keys(PHONES).length;}

document.getElementById('listBtn').onclick=()=>{
  const el=document.getElementById('phoneList');
  el.classList.toggle('open');
  if(el.classList.contains('open'))renderList();
};
function renderList(){
  const el=document.getElementById('phoneList');
  el.innerHTML='<div class="list-hdr">Довідник телефонів</div>';
  Object.entries(PHONES).sort((a,b)=>a[0].localeCompare(b[0])).forEach(([num,rec])=>{
    const known=discovered.has(num);
    const div=document.createElement('div');
    div.className='entry'+(known?' known':'');
    div.innerHTML=known
      ?`<span class="num">${num}</span><span class="dsc">${rec.icon} ${rec.desc}</span>`
      :`<span class="num">${num}</span><span class="dsc" style="color:#2a1808">● ● ●</span><span class="lck">🔒</span>`;
    if(known)div.onclick=()=>{dialedNumber=num;updateDisp();el.classList.remove('open');setTimeout(makeCall,300);};
    el.appendChild(div);
  });
}

updateDisp(); updateDiscovered();

/* ════════════════════════════════════════════════════════════
   ROTARY DIAL MECHANIC
   ════════════════════════════════════════════════════════════
   Real rotary phone logic:
   1. User presses finger into a digit hole
   2. Drags CLOCKWISE until hitting the finger stop (right side)
   3. Releases — dial springs back counter-clockwise
   4. Digit is registered on release if rotated far enough

   Digit hole positions (degrees from top, clockwise):
     1 = -54°   2 = -18°   3 = 18°   4 = 54°   5 = 90°
     6 = 126°   7 = 162°   8 = 198°  9 = 234°   0 = 270°
   Finger stop is at 90° (3-o'clock position).
   ════════════════════════════════════════════════════════════ */
(function(){
  // Where each digit's hole rests (degrees, clockwise from 12-o'clock)
  const HOLE_ANGLE = {'1':-54,'2':-18,'3':18,'4':54,'5':90,'6':126,'7':162,'8':198,'9':234,'0':270};
  // normalise to 0-360
  const norm = a => ((a%360)+360)%360;

  let dragging=false, activeDigit=null, startPointerAngle=0, curRotation=0, lastTickAngle=0;

  function svgCenter(){
    const r=dialWrap.getBoundingClientRect();
    return {cx:r.left+r.width/2, cy:r.top+r.height/2};
  }

  function ptrAngle(e){
    const {cx,cy}=svgCenter();
    const px=e.touches?e.touches[0].clientX:e.clientX;
    const py=e.touches?e.touches[0].clientY:e.clientY;
    // Returns angle in degrees where 0=right(3-o'clock), goes CCW in math
    // We want 0=top, clockwise positive:
    const rad=Math.atan2(py-cy, px-cx);
    return rad*180/Math.PI + 90; // rotate frame so 0=top
  }

  function holeWorldPos(digit, extraRot){
    // Where the hole is on screen given current dial rotation
    const baseAngle = HOLE_ANGLE[digit] + (extraRot||0);
    const {cx,cy}=svgCenter();
    const r=70 * (dialWrap.getBoundingClientRect().width/200); // scale factor
    const rad=baseAngle*Math.PI/180;
    return {x:cx+Math.sin(rad)*r, y:cy-Math.cos(rad)*r};
  }

  function findHole(e){
    const px=e.touches?e.touches[0].clientX:e.clientX;
    const py=e.touches?e.touches[0].clientY:e.clientY;
    const scale=dialWrap.getBoundingClientRect().width/200;
    let best=null, bestD=Infinity;
    for(const [d,_] of Object.entries(HOLE_ANGLE)){
      const {x,y}=holeWorldPos(d, curRotation);
      const dist=Math.hypot(px-x,py-y);
      if(dist<bestD){bestD=dist;best=d;}
    }
    return bestD < 26*scale ? best : null;
  }

  function setRot(deg){
    dialSvg.style.transform=`rotate(${deg}deg)`;
    curRotation=deg;
  }

  function onDown(e){
    if(busy)return;
    e.preventDefault();
    const hole=findHole(e);
    if(!hole)return;
    dragging=true; activeDigit=hole;
    startPointerAngle=ptrAngle(e);
    lastTickAngle=startPointerAngle;
    if(e.pointerId!=null)dialWrap.setPointerCapture&&dialWrap.setPointerCapture(e.pointerId);
  }

  function onMove(e){
    if(!dragging)return;
    e.preventDefault();
    let delta=ptrAngle(e)-startPointerAngle;
    // Unwrap
    if(delta>180)delta-=360;
    if(delta<-180)delta+=360;
    // Only CW (positive) rotation, capped at max travel to stop
    const holeRest=HOLE_ANGLE[activeDigit];
    // finger stop is at 90°. Max CW rotation = distance from hole to stop.
    const maxRot=norm(90-holeRest);
    const rot=Math.max(0,Math.min(delta,maxRot));
    setRot(rot);
    // tick every ~12°
    const cur=ptrAngle(e);
    if(Math.abs(cur-lastTickAngle)>12){lastTickAngle=cur;clickTick(300+Math.random()*120);}
  }

  function onUp(e){
    if(!dragging)return;
    e.preventDefault();
    dragging=false;
    const holeRest=HOLE_ANGLE[activeDigit];
    const maxRot=norm(90-holeRest);
    // Register if rotated >72% of max
    if(curRotation>=maxRot*0.72){addDigit(activeDigit);}
    springSound();
    // Animate spring back
    const from=curRotation;
    const t0=performance.now();
    const dur=Math.max(160, from*2.2);
    function frame(now){
      const p=Math.min(1,(now-t0)/dur);
      const ease=1-Math.pow(1-p,3);
      setRot(from*(1-ease));
      if(p<1)requestAnimationFrame(frame); else setRot(0);
    }
    requestAnimationFrame(frame);
  }

  dialWrap.addEventListener('pointerdown', onDown,{passive:false});
  window.addEventListener('pointermove',   onMove,{passive:false});
  window.addEventListener('pointerup',     onUp,  {passive:false});
  dialWrap.addEventListener('touchstart',  onDown,{passive:false});
  window.addEventListener('touchmove',     onMove,{passive:false});
  window.addEventListener('touchend',      onUp,  {passive:false});
})();
</script>
